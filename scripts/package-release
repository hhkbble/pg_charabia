#!/usr/bin/env python3
"""Package a fully verified Linux AMD64 release locally, without publishing."""
import argparse
import datetime
import json
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile

from report_contract import require_installation_files, DELIVERY_ANALYSIS_FIELDS, MODE_QUALITY_REVIEW, FORMAT, VERIFIED, digest, require_release_identity, require_release_report, verify_checksums

ROOT = Path(__file__).resolve().parent.parent
def require(condition, message):
    if not condition:
        raise SystemExit(message)


def copy_committed_sources(delivery, commit):
    """Copy the tested Git snapshot without ignored or local-only descendants."""
    paths = ("LICENSE", "README.md", "AGENTS.md", ".gitattributes", ".gitignore", ".cargo", "scripts", "tests", "docs", "src", "sql", "resources", "docker",
             "Cargo.toml", "Cargo.lock", "build.rs", "rust-toolchain.toml", "pg_charabia.control")
    entries = subprocess.check_output(["git", "ls-tree", "-rz", "--full-tree", commit, "--", *paths], cwd=ROOT)
    # The verified stage can contain local resource files. Replace each source
    # root in this owned temporary delivery with the exact tested Git snapshot.
    for relative in paths:
        target = delivery / relative
        if target.is_dir() and not target.is_symlink():
            shutil.rmtree(target)
        elif target.exists() or target.is_symlink():
            target.unlink()
    copied = set()
    for entry in entries.split(b"\0"):
        if not entry:
            continue
        metadata, filename = entry.split(b"\t", 1)
        mode, kind, object_id = metadata.decode("ascii").split()
        relative = filename.decode("utf-8")
        require(mode in ("100644", "100755") and kind == "blob", f"Refusing non-regular source input: {relative}")
        target = delivery / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(subprocess.check_output(["git", "cat-file", "blob", object_id], cwd=ROOT))
        target.chmod(0o755 if mode == "100755" else 0o644)
        copied.add(relative)
    for relative in (".cargo/config.toml", "src/lib.rs", "sql/pg_charabia.sql", "docker/verify.Dockerfile", "docker/environment.lock.json", "scripts/generate-english.py", "scripts/rebuild-german", "resources/english/words.txt", "resources/english/attribution/headword-pages.txt.gz", "tests/fixtures/quality-warnings-original.json", MODE_QUALITY_REVIEW["file"]):
        require(relative in copied, f"Required rebuild/relink source file is not committed: {relative}")
    require(set(paths) - {".cargo", "scripts", "tests", "docs", "src", "sql", "resources", "docker"} <= copied, "Required delivery source files are not committed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=Path, required=True, help="Successful outer Linux verifier evidence directory")
    parser.add_argument("--out-dir", type=Path, default=ROOT / "dist")
    args = parser.parse_args()
    evidence = args.run.resolve()
    outer = json.loads((evidence / "outer-run.json").read_text())
    require(outer.get("format") == FORMAT and outer["status"] in VERIFIED and outer["platform"] == "linux/amd64", "A successful Linux AMD64 run is required")
    require(outer["cleanup"]["container_removed"] and outer["cleanup"].get("volumes_removed", True), "Outer cleanup did not pass")
    reports = list(evidence.glob("*/run.json"))
    require(len(reports) == 1, "Expected exactly one inner verifier report")
    inner_dir = reports[0].parent
    report = json.loads(reports[0].read_text())
    require(report["run_id"] == outer["run_id"] + "-inner", "Inner and outer run IDs do not match")
    try:
        require_release_report(report)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    require(outer["status"] == report["status"], "Outer and inner quality status differ")
    current_commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    current_status = subprocess.check_output(["git", "status", "--porcelain=v1"], cwd=ROOT, text=True)
    package = inner_dir / "package"
    require_installation_files(package/"extension")
    try:
        verify_checksums(package)
        resources=json.loads((ROOT/"resources/manifest.json").read_text())
        for source in resources["rebuild_source_archives"]:
            require(digest(package/source["package_path"])==source["sha256"], "Missing or changed corresponding source archive")
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    libraries = list((package / "extension").glob("pg_charabia.so"))
    require(len(libraries) == 1, "Expected one verified Linux extension .so")
    library_hash = digest(libraries[0])
    try:
        require_release_identity(report, commit=current_commit, status=current_status, lock_hash=digest(ROOT / "Cargo.lock"), resources_hash=digest(ROOT / "resources/manifest.json"), library_hash=library_hash)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    require((ROOT / "LICENSE").is_file() and (ROOT / "README.md").is_file(), "Project LICENSE and usage README are required")
    version = report["analysis_info"]["extension"]
    name = f"pg_charabia-{version}-pg18-linux-amd64-{current_commit[:12]}"
    args.out_dir.mkdir(parents=True, exist_ok=True)
    archive = args.out_dir / (name + ".tar.gz")
    require(not archive.exists() and not archive.with_name(archive.name + ".sha256").exists(), f"Refusing to overwrite existing delivery artifact: {archive}")
    with tempfile.TemporaryDirectory(prefix="pgcb-package.") as temp:
        delivery = Path(temp) / name
        shutil.copytree(package, delivery, symlinks=True)
        copy_committed_sources(delivery, current_commit)
        verification = delivery / "verification"
        verification.mkdir()
        shutil.copy2(evidence / "outer-run.json", verification / "outer-run.json")
        for item in inner_dir.iterdir():
            require(not item.is_symlink(), f"Refusing symbolic link in verifier evidence: {item}")
            if item.is_file():
                shutil.copy2(item, verification / item.name)
            elif item.is_dir() and item.name != "package":
                shutil.copytree(item, verification / item.name, symlinks=True)
        manifest = {
            "extension": "pg_charabia", "version": version, "platform": "linux/amd64",
            "postgres_major": 18, "postgres_build": report["postgres"],
            "target": report["target_triple"], "build_profile": "release", "test_hooks": False,
            "source_commit": current_commit, "source_dirty": False,
            "verification_format": FORMAT, "verification_status": report["status"],
            **{field:report["analysis_info"][field] for field in DELIVERY_ANALYSIS_FIELDS},
            "quality": report["quality"], "structured_token_quality_costs":report["structured_token_quality_costs"],
            "verified_run": report["run_id"], "verified_outer_run": outer["run_id"],
            "library_sha256": library_hash, "cargo_lock_sha256": report["cargo_lock_sha256"],
            "resource_manifest_sha256": report["resources_sha256"], "image_id": outer["image_id"],
            "packaged_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "public_upload": False,
        }
        (delivery / "delivery-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        require(not any(p.is_symlink() for p in delivery.rglob("*")), "Refusing symbolic links in delivery inputs")
        checksums = [f"{digest(p)}  {p.relative_to(delivery)}" for p in sorted(delivery.rglob("*")) if p.is_file() and p != delivery / "SHA256SUMS"]
        (delivery / "SHA256SUMS").write_text("\n".join(checksums) + "\n")
        with tarfile.open(archive, "w:gz") as tar:
            tar.add(delivery, arcname=name)
    archive_digest = digest(archive)
    checksum_path = archive.with_name(archive.name + ".sha256")
    checksum_path.write_text(f"{archive_digest}  {archive.name}\n")
    print(json.dumps({"status": report["status"], "known_quality_failures": report["quality"]["known_failures"], "quality_warnings": report["quality"]["warnings"], "archive": str(archive.resolve()), "sha256": archive_digest, "checksum_file": str(checksum_path.resolve()), "source_commit": current_commit, "verified_run": report["run_id"]}, indent=2))

if __name__ == "__main__":
    main()
