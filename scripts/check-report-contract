ROOT = Path(__file__).resolve().parent.parent


class ContractTests(unittest.TestCase):
    def test_bm25_quality_summary_cannot_turn_warnings_into_pass(self):
        report=self.bm25_report()
        quality=require_bm25_report(report)
        self.assertEqual(quality,report["quality"])
        for forged in ("passed","verified","verified-with-known-quality-failures"):
            with self.assertRaisesRegex(ValueError,"quality status"):
                require_bm25_report(dict(report,quality_status=forged))
        altered=copy.deepcopy(report)
        altered["quality"]["counts"]["passed"]+=1
        with self.assertRaisesRegex(ValueError,"summary"):
            require_bm25_report(altered)
        altered=self.report()
        altered["bm25_quality"]=validate_quality({"format":FORMAT,"cases":[case for case in quality["cases"] if case["status"]!="warning"]})
        with self.assertRaisesRegex(ValueError,"BM25 quality cases disagree"):
            require_release_report(altered)
        passed=quality_case("independent-pass",input="alpha",query="alpha",config="public.charabia",expected=True,actual=True,mode="linguistic")
        self.assertEqual(verified_status(validate_quality({"format":FORMAT,"cases":[passed]})),"verified")
        known=[case for case in quality["cases"] if case["status"]=="known-failure"]
        self.assertEqual(verified_status(validate_quality({"format":FORMAT,"cases":known})),"verified-with-known-quality-failures")

    def test_mode_identity_and_complete_case_sets_are_required(self):
        report=self.bm25_report()
        self.assertEqual(len(required_bm25_case_ids()),247)
        require_bm25_report(report)
        for mode in MODES:
            changed=copy.deepcopy(report)
            del changed["mode_reports"][mode]
            with self.assertRaisesRegex(ValueError,"mode reports"):
                require_bm25_report(changed)
            rows=[case for case in report["domain_quality"] if case["mode"]!=mode]
            with self.assertRaisesRegex(ValueError,"coverage"):
                require_bm25_case_coverage(validate_quality({"format":FORMAT,"cases":rows}))
        rows=report["domain_quality"]
        with self.assertRaisesRegex(ValueError,"duplicate"):
            validate_quality({"format":FORMAT,"cases":rows+[copy.deepcopy(rows[0])]})
        for field in ("mode","analysis_revision"):
            changed=copy.deepcopy(rows[0]);del changed[field]
            with self.assertRaisesRegex(ValueError,"Incomplete"):
                validate_quality({"format":FORMAT,"cases":[changed]})
        for mode,config in (("linguistic","public.charabia_structured"),("structured","public.charabia_linguistic")):
            with self.assertRaisesRegex(ValueError,"conflicts"):
                quality_case("wrong-mode",input="alpha",query="alpha",config=config,expected=True,actual=True,mode=mode)
        for old_format in (1,2):
            with self.assertRaisesRegex(ValueError,"format"):
                validate_quality({"format":old_format,"cases":[]})

    def test_git_worktree_metadata_mount_is_read_only_and_specific(self):
        import runpy
        mounts=runpy.run_path(str(ROOT/"scripts/run-linux.py"))["git_metadata_mounts"]
        with tempfile.TemporaryDirectory() as directory:
            root=Path(directory)/"repository";root.mkdir()
            def git(*args):
                return subprocess.check_output(["git","-C",str(root),*args],text=True,stderr=subprocess.PIPE)
            git("init","--quiet")
            (root/"seed").write_text("owned fixture\n")
            git("add","seed")
            git("-c","user.name=Fixture","-c","user.email=fixture@example.invalid","commit","--quiet","-m","Fixture")
            worktree=Path(directory)/"worktree"
            git("worktree","add","--detach",str(worktree),"HEAD")
            self.assertEqual(mounts(root),[])
            common=(root/".git").resolve()
            self.assertEqual(mounts(worktree),["--mount",f"type=bind,src={common},dst={common},readonly"])

    def test_delivery_analysis_identity_requires_both_modes(self):
        info=self.info()
        manifest={field:copy.deepcopy(info[field]) for field in DELIVERY_ANALYSIS_FIELDS}
        require_delivery_analysis_identity(manifest,info)
        for field in DELIVERY_ANALYSIS_FIELDS:
            changed=copy.deepcopy(manifest);del changed[field]
            with self.assertRaisesRegex(ValueError,"Delivery analysis identity"):
                require_delivery_analysis_identity(changed,info)
        changed=copy.deepcopy(manifest);changed["modes"].pop()
        with self.assertRaisesRegex(ValueError,"Delivery analysis identity"):
            require_delivery_analysis_identity(changed,info)

    def test_mode_report_format_costs_and_client_exit_evidence_are_required(self):
        report=self.bm25_report()
        for changed in (dict(report,format=2),dict(report,analysis_revision="old")):
            with self.assertRaisesRegex(ValueError,"format or analysis identity"):
                require_bm25_report(changed)
        changed=copy.deepcopy(report);del changed["mode_reports"]["structured"]["structured_tokens"]
        with self.assertRaisesRegex(ValueError,"precision cost"):
            require_bm25_report(changed)
        for key,value in (("signal_handoff_registered",False),("direct_waited",False),("group_empty",False),("cleanup_complete",False),
                          ("remaining_owned_pids",[123]),("errors",["unjoined"]),("direct_exit_code",1)):
            changed=self.recovery();changed["client_exit_proofs"][0][key]=value
            with self.assertRaisesRegex(ValueError,"client process exit"):
                require_recovery_report(changed,"f"*64)
        changed=self.recovery();changed["cleanup"]["clients_joined"]=False
        with self.assertRaisesRegex(ValueError,"clients were not joined"):
            require_recovery_report(changed,"f"*64)

    def test_all_quality_provenance_hashes_are_immutable(self):
        fixtures=("tests/fixtures/quality-known.json",QUALITY_WARNING_REVIEW["file"],MODE_QUALITY_REVIEW["file"])
        messages=("Reviewed frozen quality evidence changed","Reviewed quality warning evidence changed","Mode quality review evidence changed")
        for modified,message in zip(fixtures,messages):
            with tempfile.TemporaryDirectory() as directory:
                root=Path(directory)
                for name in ("scripts/report_contract.py",*fixtures):
                    target=root/name;target.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(ROOT/name,target)
                path=root/modified;path.write_bytes(path.read_bytes()+b"\n")
                script="import sys;sys.path.insert(0,'scripts');from report_contract import frozen_quality_cases,quality_case;v=frozen_quality_cases()['english-short-phrase'];quality_case('english-short-phrase',**v,known_signature=v,mode='linguistic',observed_signature={})"
                result=subprocess.run([sys.executable,"-c",script],cwd=root,text=True,capture_output=True)
                self.assertNotEqual(result.returncode,0)
                self.assertIn(message,result.stderr)

    def test_public_api_requires_strict_search_path_and_actual_default(self):
        actual=public_api_abi()
        require_public_api_abi(actual)
        for index in range(3):
            for key in ("strict","configuration","default_count","defaults"):
                changed=copy.deepcopy(actual);changed[index][key]=None if key!="defaults" else "'english'::regconfig"
                with self.assertRaisesRegex(ValueError,"Public diagnostic ABI"):
                    require_public_api_abi(changed)
        with self.assertRaises(ValueError):require_public_api_abi(actual+[copy.deepcopy(actual[1])])

    def test_staging_and_packaging_require_exact_installation_and_upgrade_sql(self):
        with tempfile.TemporaryDirectory() as directory:
            stage=Path(directory)
            current=stage/f"pg_charabia--{RELEASE_VERSION}.sql"
            current.write_text("-- owned current fixture\n")
            with self.assertRaises(ValueError):require_installation_files(stage)
            upgrade=stage/"pg_charabia--0.4.1--0.4.2.sql"
            upgrade.write_text("-- owned exact upgrade fixture\n")
            require_installation_files(stage)
            for old in ("pg_charabia--0.3.0.sql","pg_charabia--0.3.0--0.3.1.sql","pg_charabia--0.3.1--0.4.0.sql",
                        "pg_charabia--0.4.0.sql","pg_charabia--0.4.1.sql","pg_charabia--0.4.0--0.4.2.sql",
                        "pg_charabia--0.4.2--0.4.3.sql"):
                path=stage/old;path.write_text("-- rejected old fixture\n")
                with self.assertRaisesRegex(ValueError,"exact 0.4.1 to 0.4.2 upgrade"):
                    require_installation_files(stage)
                path.unlink()
            current.unlink()
            with self.assertRaises(ValueError):require_installation_files(stage)

    def test_recovery_requires_both_mode_histories_and_exited_processes(self):
        report=self.recovery()
        require_recovery_report(report,"f"*64)
        for stage in ("target","crash","restored"):
            for mode in MODES:
                changed=copy.deepcopy(report);del changed["mode_evidence"][stage][mode]
                with self.assertRaisesRegex(ValueError,"mode evidence"):
                    require_recovery_report(changed,"f"*64)
                changed=copy.deepcopy(report)
                changed["mode_evidence"][stage][mode]["target_state"]=not changed["mode_evidence"][stage][mode]["target_state"]
                with self.assertRaisesRegex(ValueError,"target state"):
                    require_recovery_report(changed,"f"*64)
        for key,value in (("status_exit",0),("pid_file_absent",False),("remaining_owned_pids",[123]),("processes",{})):
            changed=copy.deepcopy(report);changed["cluster_exit_proofs"][0][key]=value
            with self.assertRaisesRegex(ValueError,"process exit"):
                require_recovery_report(changed,"f"*64)
        changed=copy.deepcopy(report);changed["child_subreaper"]["current"]=0
        with self.assertRaisesRegex(ValueError,"subreaper"):
            require_recovery_report(changed,"f"*64)

    def test_boolean_warning_signatures_reject_a_different_failure(self):
        for mode in MODES:
            rows={case["id"]:case for case in self.quality_cases() if case["mode"]==mode}
            for case_id in ("english-short-phrase","german-die-precision","bm25-topk-domain"):
                original=rows[case_id]
                self.assertIn(original["status"],("known-failure","warning"))
                fields={key:original[key] for key in QUALITY_FIELDS}
                fields.update(mode=mode,known_signature=original.get("known_signature"))
                self.assertEqual(quality_case(case_id,**fields)["status"],"regression")
                signature=copy.deepcopy(original["observed_signature"])
                signature["query_ast"]="'different'"
                self.assertEqual(quality_case(case_id,**fields,observed_signature=signature)["status"],"regression")
            top=rows["bm25-topk-domain"]
            fields={key:top[key] for key in QUALITY_FIELDS};fields["mode"]=mode
            for key,value in (("winner_ids",[13]),("candidate_ids",[1,2,9,13])):
                signature=copy.deepcopy(top["observed_signature"]);signature[key]=value
                self.assertEqual(quality_case("bm25-topk-domain",**fields,observed_signature=signature)["status"],"regression")

    def test_request_rss_gate_rejects_private_growth_without_ignoring_shared_growth(self):
        module = ast.parse((ROOT / "tests/stress.py").read_text())
        function = next(node for node in module.body if isinstance(node, ast.FunctionDef) and node.name == "request_rss_summary")
        namespace = {"statistics": statistics, "MIB": 1024 * 1024, "LINUX": True}
        exec(compile(ast.Module(body=[function], type_ignores=[]), "tests/stress.py", "exec"), namespace)
        summary = namespace["request_rss_summary"]
        mib = namespace["MIB"]
        for growth, expected in ((mib, True), (mib + 1, False), (-1, True)):
            samples = [dict(cycle=cycle, rss_bytes=10*mib+(growth if cycle >= 3 else 0),
                            rss_nonshared_bytes=5*mib+(growth if cycle >= 3 else 0)) for cycle in range(6)]
            self.assertEqual(summary(samples)["rss_gate_passed"], expected)
        shared_growth = [dict(cycle=cycle, rss_bytes=(10 if cycle < 3 else 12)*mib,
                              rss_nonshared_bytes=5*mib) for cycle in range(6)]
        observed = summary(shared_growth)
        self.assertTrue(observed["rss_gate_passed"])
        self.assertFalse(observed["raw_total_rss_gate_passed"])
        self.assertEqual(observed["rss_median_growth_bytes"], 2*mib)

    def recovery_command_namespace(self,out,report):
        import ctypes,signal,time
        module=ast.parse((ROOT/"tests/recovery.py").read_text())
        names={"save","check","enable_child_subreaper","client_group","finish_client","restore_child_signal_mask","command"}
        functions=[node for node in module.body if isinstance(node,ast.FunctionDef) and node.name in names]
        namespace=dict(OUT=out,REPORT=report,ENV=os.environ.copy(),CLIENTS={},Path=Path,time=time,
                       subprocess=subprocess,json=json,os=os,signal=signal,ctypes=ctypes)
        exec(compile(ast.Module(body=functions,type_ignores=[]),"tests/recovery.py","exec"),namespace)
        return namespace

    def test_recovery_keeps_first_failure_when_a_command_label_repeats(self):
        with tempfile.TemporaryDirectory() as directory:
            out=Path(directory);report={"commands":[],"checks":[]}
            namespace=self.recovery_command_namespace(out,report)
            if sys.platform!="linux":
                # These two logging commands cannot fork. A portable kernel
                # group probe keeps this logging test independent of /proc.
                # Linux fork ownership and reaping are exercised below.
                def single_client_group(pgid):
                    try:os.killpg(pgid,0)
                    except ProcessLookupError:return {}
                    return {pgid:dict(parent=os.getpid(),start_ticks=str(pgid),state="R")}
                namespace["client_group"]=single_client_group
            command=namespace["command"]
            command([sys.executable,"-c","import sys; print('FIRST_FAILURE',file=sys.stderr);sys.exit(1)"],"repeat",check=False)
            command([sys.executable,"-c","print('SECOND_SUCCESS')"],"repeat")
            first,second=report["commands"]
            self.assertEqual([first["exit"],second["exit"]],[1,0])
            self.assertNotEqual(first["stderr"],second["stderr"])
            self.assertEqual((out/first["stderr"]).read_text(),"FIRST_FAILURE\n")
            self.assertEqual((out/second["stdout"]).read_text(),"SECOND_SUCCESS\n")
            self.assertEqual(namespace["CLIENTS"],{})

    def test_recovery_client_groups_handle_timeout_and_interruption(self):
        import signal,uuid
        base=Path(os.environ.get("PGCB_RUN_DIR",ROOT/"artifacts"))
        out=base/("runner-client-contract-"+uuid.uuid4().hex)
        out.mkdir(parents=True)
        report={"commands":[],"checks":[],"scope":"Owned client groups; Linux subreaper or unsupported-platform guard"}
        namespace=self.recovery_command_namespace(out,report)
        if sys.platform!="linux":
            with self.assertRaisesRegex(AssertionError,"requires Linux"):
                namespace["enable_child_subreaper"]()
            self.assertFalse(report["child_subreaper"]["enabled"])
            self.assertEqual(namespace["CLIENTS"],{})
            return
        namespace["enable_child_subreaper"]()
        code="import os,signal,time;signal.signal(signal.SIGTERM,signal.SIG_IGN);child=os.fork();print(('CHILD' if child==0 else 'PARENT')+':'+str(os.getpid()),flush=True);time.sleep(60)"
        try:
            with self.assertRaises(subprocess.TimeoutExpired):
                namespace["command"]([sys.executable,"-c",code],"client-timeout",timeout=.5)
            def interrupt(signum,frame):raise InterruptedError("controlled client interruption")
            previous=signal.signal(signal.SIGALRM,interrupt)
            try:
                signal.setitimer(signal.ITIMER_REAL,.5)
                with self.assertRaises(InterruptedError):
                    namespace["command"]([sys.executable,"-c",code],"client-interruption",timeout=120)
            finally:
                signal.setitimer(signal.ITIMER_REAL,0)
                signal.signal(signal.SIGALRM,previous)
            # Deliver handled signals at the exact spawn-to-registration handoff.
            # The child is real and forks; only the Popen call boundary is wrapped.
            import types,time
            actual_popen=subprocess.Popen
            for pending_signal in (signal.SIGINT,signal.SIGTERM):
                spawned=[]
                def pending_spawn(*args,**kwargs):
                    process=actual_popen(*args,**kwargs);spawned.append(process)
                    deadline=time.monotonic()+5
                    output=out/report["commands"][-1]["stdout"]
                    while time.monotonic()<deadline and "CHILD:" not in output.read_text():
                        time.sleep(.02)
                    os.kill(os.getpid(),pending_signal)
                    return process
                def handled(signum,frame):raise InterruptedError("controlled registration signal "+str(signum))
                previous=signal.signal(pending_signal,handled)
                namespace["subprocess"]=types.SimpleNamespace(Popen=pending_spawn,TimeoutExpired=subprocess.TimeoutExpired)
                masked_code="import signal;print('MASK:'+str(sorted(map(int,signal.pthread_sigmask(signal.SIG_BLOCK,set())))),flush=True);"+code
                try:
                    with self.assertRaisesRegex(InterruptedError,"controlled registration signal"):
                        namespace["command"]([sys.executable,"-c",masked_code],"registration-"+str(int(pending_signal)))
                    self.assertEqual(len(spawned),1)
                    text=(out/report["commands"][-1]["stdout"]).read_text()
                    self.assertIn("MASK:[]",text)
                    self.assertIn("CHILD:",text)
                finally:
                    signal.signal(pending_signal,previous)
                    namespace["subprocess"]=subprocess
                    # A failing handoff must still retain and join the actual
                    # process created by this test wrapper before returning.
                    for process in spawned:
                        if process.pid not in namespace["CLIENTS"] and process.returncode is None:
                            proof=dict(pgid=process.pid,members={},signals=[],reaped_owned_children=[],errors=[])
                            namespace["finish_client"](process,proof,True)
            self.assertEqual([entry["exit"] for entry in report["commands"]],["timeout","interrupted","interrupted","interrupted"])
            for proof in report["client_exit_proofs"]:
                self.assertTrue(proof["signal_handoff_registered"])
                self.assertTrue(proof["direct_waited"])
                self.assertTrue(proof["group_empty"])
                self.assertTrue(proof["cleanup_complete"])
                self.assertEqual(proof["remaining_owned_pids"],[])
                self.assertEqual(proof["errors"],[])
                self.assertIn(int(signal.SIGTERM),proof["signals"])
                self.assertIn(int(signal.SIGKILL),proof["signals"])
                self.assertTrue(proof["reaped_owned_children"])
            self.assertEqual(namespace["CLIENTS"],{})
        finally:
            # Preserve every first error before using the same owned cleanup on
            # a failed assertion. Never leave this controlled fork tree running.
            namespace["save"]()
            for process,proof in list(namespace["CLIENTS"].values()):
                namespace["finish_client"](process,proof,True)

    def test_outer_cleanup_preserves_unproven_inner_data(self):
        # This exercises the actual outer wrapper with a fake Docker CLI, not
        # PostgreSQL behavior. Target integration still runs in real containers.
        fake = r"""#!/usr/bin/env python3
import json,os,sys
from pathlib import Path
args=sys.argv[1:];root=Path(os.environ['PGCB_FAKE_DOCKER_ROOT'])
with(root/'calls.jsonl').open('a')as f:f.write(json.dumps(args)+'\n')
state=root/'state.json';case=os.environ['PGCB_FAKE_DOCKER_CASE']
if args[:2]==['image','inspect']:
 print(json.dumps([{'Architecture':'amd64','Os':'linux','Id':'fake-policy-image'}]));sys.exit()
if args[0]=='create':
 mount=next(a for a in args if a.startswith('type=bind,src=')and a.endswith(',dst=/evidence'))
 evidence=Path(mount.split('src=',1)[1].rsplit(',dst=',1)[0])
 run=next(a.split('=',1)[1]for a in args if a.startswith('PGCB_RUN_ID='))
 state.write_text(json.dumps({'evidence':str(evidence),'run':run,'removed':False}))
 if case.startswith('create-probe-'):sys.exit(1)
 print('owned-policy-container');sys.exit()
value=json.loads(state.read_text())
if args[0]=='start':
 out=Path(value['evidence'])/value['run'];out.mkdir()
 report={'format':3,'run_id':value['run'],'platform':'linux-amd64','status':'verified',
         'cleanup':{'marker_matches':True,'cluster_stopped':True,'directory_removed':True}}
 if case=='missing':sys.exit(1)
 if case=='malformed':(out/'run.json').write_text('{');sys.exit(1)
 if case=='wrong-run':report['run_id']='another-run'
 if case=='cleanup-failed':report['status']='cleanup-failed'
 if case=='unstopped':report['cleanup']['cluster_stopped']=False
 if case=='truthy-flag':report['cleanup']['directory_removed']='true'
 if case=='recovery-unproven':report['cleanup']['recovery_children_cleaned']=False
 if case=='recovery-missing':report['cleanup']['recovery_children_cleaned']=True
 if case in ('recovery-failed','recovery-safe-failure','recovery-unjoined-client'):
  report['cleanup']['recovery_children_cleaned']=True
  child={'format':3,'run':value['run'],'status':'failed','cleanup':
         {'marker_matches':True,'clusters_stopped':case!='recovery-failed','directory_removed':True,
          'clients_joined':case!='recovery-unjoined-client'}}
  (out/'recovery').mkdir();(out/'recovery/results.json').write_text(json.dumps(child))
  report['recovery']=child
 if case in ('safe-failure','recovery-safe-failure'):report['status']='failed'
 (out/'run.json').write_text(json.dumps(report))
 sys.exit(0 if report['status']=='verified'else 1)
if args[:2]==['volume','inspect']:
 if case=='volume-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
 if case=='volume-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
 print('Error response from daemon: get '+args[-1]+': no such volume',file=sys.stderr);sys.exit(1)
if args[0]=='inspect':
 if case=='create-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
 if case=='create-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
 if case=='create-probe-absent':print('Error: No such object: '+args[-1],file=sys.stderr);sys.exit(1)
 if value['removed']:
  if case=='container-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
  if case=='container-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
  if case=='container-probe-other-object':print('Error: No such object: another-container',file=sys.stderr);sys.exit(1)
  if case=='container-probe-malformed':print('not-json');sys.exit()
  print('error: no such object: '+args[-1],file=sys.stderr);sys.exit(1)
 mounts=[{'Type':'volume','Name':'owned-policy-volume'}] if case.startswith('volume-probe-') else []
 print(json.dumps([{'State':{'Running':False,'ExitCode':0},'Mounts':mounts}]))
 sys.exit()
if args[0]=='rm':value['removed']=True;state.write_text(json.dumps(value));sys.exit()
if args[0]in('logs','stop'):sys.exit()
raise SystemExit('unexpected fake Docker command: '+repr(args))
"""
        cases = ("success", "safe-failure", "recovery-safe-failure", "missing", "malformed",
                 "wrong-run", "cleanup-failed", "unstopped", "truthy-flag",
                 "recovery-unproven", "recovery-missing", "recovery-failed", "recovery-unjoined-client",
                 "container-probe-daemon", "container-probe-permission", "container-probe-other-object",
                 "container-probe-malformed", "volume-probe-daemon", "volume-probe-permission",
                 "volume-probe-absent", "create-probe-daemon", "create-probe-permission", "create-probe-absent")
        for case in cases:
            with self.subTest(case=case), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                (root / "scripts").mkdir()
                (root / "resources").mkdir()
                (root / "resources/manifest.json").write_text('{"archives":[]}')
                for name in ("run-linux.py", "report_contract.py"):
                    shutil.copy2(ROOT / "scripts" / name, root / "scripts" / name)
                docker = root / "docker"
                docker.write_text(fake)
                docker.chmod(0o755)
                env = dict(os.environ, PATH=str(root) + os.pathsep + os.environ.get("PATH", ""),
                           PGCB_FAKE_DOCKER_ROOT=str(root), PGCB_FAKE_DOCKER_CASE=case,
                           PGCB_LINUX_CACHE=str(root / "cache"))
                result = subprocess.run([sys.executable, str(root / "scripts/run-linux.py"),
                                         "--suite", "build", "--no-build-image"],
                                        env=env, text=True, capture_output=True)
                calls = [json.loads(line) for line in (root / "calls.jsonl").read_text().splitlines()]
                removed = any(call[0] == "rm" for call in calls)
                safe = case in ("success", "safe-failure", "recovery-safe-failure", "volume-probe-absent")
                attempted_removal = safe or case.startswith(("container-probe-", "volume-probe-"))
                self.assertEqual(removed, attempted_removal, {"case": case, "calls": calls,
                                                "stdout": result.stdout, "stderr": result.stderr})
                report = json.loads(next((root / "artifacts").glob("*/outer-run.json")).read_text())
                cleanup_proven = safe or case == "create-probe-absent"
                if not cleanup_proven:
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(report["status"], "cleanup-failed")
                    self.assertFalse(report["cleanup"]["container_removed"] and report["cleanup"].get("volumes_removed", True))
                    if not attempted_removal and not case.startswith("create-probe-"):
                        self.assertTrue(report["cleanup"]["container_retained"])
                    if case.startswith(("container-probe-", "volume-probe-", "create-probe-")):
                        self.assertIn("error", report["cleanup"])
                else:
                    self.assertTrue(report["cleanup"]["container_removed"])
                    self.assertTrue(report["cleanup"].get("volumes_removed", True))
                    self.assertEqual(result.returncode == 0, case in ("success", "volume-probe-absent"))

    def test_connection_defaults_cannot_escape_owned_cluster(self):
        allowed={"PATH":"/tools", "PG_CONFIG":"/explicit/pg_config", "PGRX_HOME":"/private/pgrx", "PGCB_RUN_ID":"owned"}
        client_keys=("PGSERVICE","PGSERVICEFILE","PGHOSTADDR","PGHOST","PGPORT","PGDATABASE","PGUSER","PGPASSWORD","PGPASSFILE","PGOPTIONS","PGCLIENTENCODING","PGTARGETSESSIONATTRS","PGSSLMODE","PGAPPNAME","PGCONNECT_TIMEOUT")
        source=dict(allowed,**{key:"must not reach libpq"for key in client_keys})
        before=source.copy()
        clean=isolated_pg_environment(source)
        self.assertEqual(clean,allowed)
        self.assertEqual(source,before)
        self.assertNotIn("PGSERVICE",clean)

    def test_notice_gate_rejects_missing_changed_or_unlisted_files(self):
        specification=importlib.util.spec_from_file_location("resource_check",ROOT/"scripts/prepare-resources.py")
        module=importlib.util.module_from_spec(specification)
        specification.loader.exec_module(module)
        expected=json.loads((ROOT/"resources/manifest.json").read_text())["notice_files"]
        with tempfile.TemporaryDirectory() as directory:
            resources=Path(directory).resolve()/"resources"
            shutil.copytree(ROOT/"resources/notices",resources/"notices")
            module.verify_notice_files(resources,expected)
            missing=resources/next(iter(expected))
            original=missing.read_bytes()
            missing.unlink()
            with self.assertRaisesRegex(RuntimeError,"Notice files differ"):
                module.verify_notice_files(resources,expected)
            missing.write_bytes(original+b"changed")
            with self.assertRaisesRegex(RuntimeError,"SHA-256 mismatch"):
                module.verify_notice_files(resources,expected)
            missing.write_bytes(original)
            (resources/"notices/unlisted").write_text("unreviewed")
            with self.assertRaisesRegex(RuntimeError,"Notice files differ"):
                module.verify_notice_files(resources,expected)
            (resources/"notices/unlisted").unlink()
            outside=resources.parent/"outside"
            outside.mkdir()
            (outside/"unverified").write_text("must not enter the package")
            for label,target in (("external",outside),("internal",resources/"notices"),("dangling",resources.parent/"absent")):
                alias=resources/"notices"/label
                alias.symlink_to(target,target_is_directory=True)
                with self.assertRaisesRegex(RuntimeError,"symbolic link",msg=label):
                    module.verify_notice_files(resources,expected)
                alias.unlink()
            for label,target in (("root",resources),("ancestor",resources.parent)):
                alias=resources.parent/(label+"-alias")
                alias.symlink_to(target,target_is_directory=True)
                input_path=alias if label=="root" else alias/"resources"
                with self.assertRaisesRegex(RuntimeError,"symbolic link",msg=label):
                    module.verify_notice_files(input_path,expected)
                alias.unlink()

    def test_suite_validation_before_environment(self):
        for entry in ("dev-test", "verify-linux-amd64"):
            result = subprocess.run([str(ROOT / "scripts" / entry), "--suite", "not-a-suite"], text=True, capture_output=True)
            self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
            self.assertNotIn("evidence:", result.stdout)
            self.assertIn("Unknown suite", result.stderr)
        with tempfile.TemporaryDirectory() as directory:
            with self.assertRaisesRegex(ValueError, "not implemented"):
                select_suites(["headline"], "linux-amd64", directory)
        for selection in (["all,unit"], ["build,unit"], ["unit,unit"], [""]):
            with self.assertRaises(ValueError):
                select_suites(selection, "linux-amd64", ROOT)
        for selection in ("smoke", "bm25", "stress", "recovery", "benchmark", "all"):
            with self.assertRaisesRegex(ValueError, "Linux verifier"):
                select_suites([selection], "macos-arm64", ROOT)
        with tempfile.TemporaryDirectory() as directory:
            tests = Path(directory) / "tests"
            tests.mkdir()
            for suite in SUITES:
                if suite != "unit":
                    (tests / (suite + ".py")).write_text("# Selection fixture only\n")
            self.assertEqual(select_suites(None, "linux-amd64", directory), list(SUITES))
            self.assertEqual(select_suites(None, "macos-arm64", directory), list(MAC_DEFAULT))
            self.assertEqual(ARCHIVE_SUITES, ("smoke", "structured", "chain", "headline", "config", "recovery"))
            for suite in ("chain", "recovery"):
                (tests / (suite + ".py")).unlink()
                with self.assertRaisesRegex(ValueError, "not implemented"):
                    select_suites([suite], "linux-amd64", directory)

    def test_disclosed_structured_costs_cannot_disappear_from_delivery(self):
