ROOT = Path(__file__).resolve().parent.parent


class ContractTests(unittest.TestCase):
    def test_outer_cleanup_preserves_unproven_inner_data(self):
        # This exercises the actual outer wrapper with a fake Docker CLI, not
        # PostgreSQL behavior. Target integration still runs in real containers.
        fake = r"""#!/usr/bin/env python3
import json,os,sys
from pathlib import Path
args=sys.argv[1:];root=Path(os.environ['PGCB_FAKE_DOCKER_ROOT'])
with(root/'calls.jsonl').open('a')as f:f.write(json.dumps(args)+'\n')
state=root/'state.json';case=os.environ['PGCB_FAKE_DOCKER_CASE']
if args[:2]==['image','inspect']:
 print(json.dumps([{'Architecture':'amd64','Os':'linux','Id':'fake-policy-image'}]));sys.exit()
if args[0]=='create':
 mount=next(a for a in args if a.startswith('type=bind,src=')and a.endswith(',dst=/evidence'))
 evidence=Path(mount.split('src=',1)[1].rsplit(',dst=',1)[0])
 run=next(a.split('=',1)[1]for a in args if a.startswith('PGCB_RUN_ID='))
 state.write_text(json.dumps({'evidence':str(evidence),'run':run,'removed':False}))
 if case.startswith('create-probe-'):sys.exit(1)
 print('owned-policy-container');sys.exit()
value=json.loads(state.read_text())
if args[0]=='start':
 out=Path(value['evidence'])/value['run'];out.mkdir()
 report={'format':2,'run_id':value['run'],'platform':'linux-amd64','status':'verified',
         'cleanup':{'marker_matches':True,'cluster_stopped':True,'directory_removed':True}}
 if case=='missing':sys.exit(1)
 if case=='malformed':(out/'run.json').write_text('{');sys.exit(1)
 if case=='wrong-run':report['run_id']='another-run'
 if case=='cleanup-failed':report['status']='cleanup-failed'
 if case=='unstopped':report['cleanup']['cluster_stopped']=False
 if case=='truthy-flag':report['cleanup']['directory_removed']='true'
 if case=='recovery-unproven':report['cleanup']['recovery_children_cleaned']=False
 if case=='recovery-missing':report['cleanup']['recovery_children_cleaned']=True
 if case in ('recovery-failed','recovery-safe-failure'):
  report['cleanup']['recovery_children_cleaned']=True
  child={'format':2,'run':value['run'],'status':'failed','cleanup':
         {'marker_matches':True,'clusters_stopped':case=='recovery-safe-failure','directory_removed':True}}
  (out/'recovery').mkdir();(out/'recovery/results.json').write_text(json.dumps(child))
  report['recovery']=child
 if case in ('safe-failure','recovery-safe-failure'):report['status']='failed'
 (out/'run.json').write_text(json.dumps(report))
 sys.exit(0 if report['status']=='verified'else 1)
if args[:2]==['volume','inspect']:
 if case=='volume-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
 if case=='volume-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
 print('Error response from daemon: get '+args[-1]+': no such volume',file=sys.stderr);sys.exit(1)
if args[0]=='inspect':
 if case=='create-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
 if case=='create-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
 if case=='create-probe-absent':print('Error: No such object: '+args[-1],file=sys.stderr);sys.exit(1)
 if value['removed']:
  if case=='container-probe-daemon':print('Cannot connect to the Docker daemon',file=sys.stderr);sys.exit(1)
  if case=='container-probe-permission':print('permission denied while connecting to Docker',file=sys.stderr);sys.exit(1)
  if case=='container-probe-other-object':print('Error: No such object: another-container',file=sys.stderr);sys.exit(1)
  if case=='container-probe-malformed':print('not-json');sys.exit()
  print('error: no such object: '+args[-1],file=sys.stderr);sys.exit(1)
 mounts=[{'Type':'volume','Name':'owned-policy-volume'}] if case.startswith('volume-probe-') else []
 print(json.dumps([{'State':{'Running':False,'ExitCode':0},'Mounts':mounts}]))
 sys.exit()
if args[0]=='rm':value['removed']=True;state.write_text(json.dumps(value));sys.exit()
if args[0]in('logs','stop'):sys.exit()
raise SystemExit('unexpected fake Docker command: '+repr(args))
"""
        cases = ("success", "safe-failure", "recovery-safe-failure", "missing", "malformed",
                 "wrong-run", "cleanup-failed", "unstopped", "truthy-flag",
                 "recovery-unproven", "recovery-missing", "recovery-failed",
                 "container-probe-daemon", "container-probe-permission", "container-probe-other-object",
                 "container-probe-malformed", "volume-probe-daemon", "volume-probe-permission",
                 "volume-probe-absent", "create-probe-daemon", "create-probe-permission", "create-probe-absent")
        for case in cases:
            with self.subTest(case=case), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                (root / "scripts").mkdir()
                (root / "resources").mkdir()
                (root / "resources/manifest.json").write_text('{"archives":[]}')
                for name in ("run-linux.py", "report_contract.py"):
                    shutil.copy2(ROOT / "scripts" / name, root / "scripts" / name)
                docker = root / "docker"
                docker.write_text(fake)
                docker.chmod(0o755)
                env = dict(os.environ, PATH=str(root) + os.pathsep + os.environ.get("PATH", ""),
                           PGCB_FAKE_DOCKER_ROOT=str(root), PGCB_FAKE_DOCKER_CASE=case,
                           PGCB_LINUX_CACHE=str(root / "cache"))
                result = subprocess.run([sys.executable, str(root / "scripts/run-linux.py"),
                                         "--suite", "build", "--no-build-image"],
                                        env=env, text=True, capture_output=True)
                calls = [json.loads(line) for line in (root / "calls.jsonl").read_text().splitlines()]
                removed = any(call[0] == "rm" for call in calls)
                safe = case in ("success", "safe-failure", "recovery-safe-failure", "volume-probe-absent")
                attempted_removal = safe or case.startswith(("container-probe-", "volume-probe-"))
                self.assertEqual(removed, attempted_removal, {"case": case, "calls": calls,
                                                "stdout": result.stdout, "stderr": result.stderr})
                report = json.loads(next((root / "artifacts").glob("*/outer-run.json")).read_text())
                cleanup_proven = safe or case == "create-probe-absent"
                if not cleanup_proven:
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(report["status"], "cleanup-failed")
                    self.assertFalse(report["cleanup"]["container_removed"] and report["cleanup"].get("volumes_removed", True))
                    if not attempted_removal and not case.startswith("create-probe-"):
                        self.assertTrue(report["cleanup"]["container_retained"])
                    if case.startswith(("container-probe-", "volume-probe-", "create-probe-")):
                        self.assertIn("error", report["cleanup"])
                else:
                    self.assertTrue(report["cleanup"]["container_removed"])
                    self.assertTrue(report["cleanup"].get("volumes_removed", True))
                    self.assertEqual(result.returncode == 0, case in ("success", "volume-probe-absent"))

    def test_connection_defaults_cannot_escape_owned_cluster(self):
        allowed={"PATH":"/tools", "PG_CONFIG":"/explicit/pg_config", "PGRX_HOME":"/private/pgrx", "PGCB_RUN_ID":"owned"}
        client_keys=("PGSERVICE","PGSERVICEFILE","PGHOSTADDR","PGHOST","PGPORT","PGDATABASE","PGUSER","PGPASSWORD","PGPASSFILE","PGOPTIONS","PGCLIENTENCODING","PGTARGETSESSIONATTRS","PGSSLMODE","PGAPPNAME","PGCONNECT_TIMEOUT")
        source=dict(allowed,**{key:"must not reach libpq"for key in client_keys})
        before=source.copy()
        clean=isolated_pg_environment(source)
        self.assertEqual(clean,allowed)
        self.assertEqual(source,before)
        self.assertNotIn("PGSERVICE",clean)

    def test_notice_gate_rejects_missing_changed_or_unlisted_files(self):
        specification=importlib.util.spec_from_file_location("resource_check",ROOT/"scripts/prepare-resources.py")
        module=importlib.util.module_from_spec(specification)
        specification.loader.exec_module(module)
        expected=json.loads((ROOT/"resources/manifest.json").read_text())["notice_files"]
        with tempfile.TemporaryDirectory() as directory:
            resources=Path(directory).resolve()/"resources"
            shutil.copytree(ROOT/"resources/notices",resources/"notices")
            module.verify_notice_files(resources,expected)
            missing=resources/next(iter(expected))
            original=missing.read_bytes()
            missing.unlink()
            with self.assertRaisesRegex(RuntimeError,"Notice files differ"):
                module.verify_notice_files(resources,expected)
            missing.write_bytes(original+b"changed")
            with self.assertRaisesRegex(RuntimeError,"SHA-256 mismatch"):
                module.verify_notice_files(resources,expected)
            missing.write_bytes(original)
            (resources/"notices/unlisted").write_text("unreviewed")
            with self.assertRaisesRegex(RuntimeError,"Notice files differ"):
                module.verify_notice_files(resources,expected)
            (resources/"notices/unlisted").unlink()
            outside=resources.parent/"outside"
            outside.mkdir()
            (outside/"unverified").write_text("must not enter the package")
            for label,target in (("external",outside),("internal",resources/"notices"),("dangling",resources.parent/"absent")):
                alias=resources/"notices"/label
                alias.symlink_to(target,target_is_directory=True)
                with self.assertRaisesRegex(RuntimeError,"symbolic link",msg=label):
                    module.verify_notice_files(resources,expected)
                alias.unlink()
            for label,target in (("root",resources),("ancestor",resources.parent)):
                alias=resources.parent/(label+"-alias")
                alias.symlink_to(target,target_is_directory=True)
                input_path=alias if label=="root" else alias/"resources"
                with self.assertRaisesRegex(RuntimeError,"symbolic link",msg=label):
                    module.verify_notice_files(input_path,expected)
                alias.unlink()

    def test_suite_validation_before_environment(self):
        for entry in ("dev-test", "verify-linux-amd64"):
            result = subprocess.run([str(ROOT / "scripts" / entry), "--suite", "not-a-suite"], text=True, capture_output=True)
            self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
            self.assertNotIn("evidence:", result.stdout)
            self.assertIn("Unknown suite", result.stderr)
        with tempfile.TemporaryDirectory() as directory:
            with self.assertRaisesRegex(ValueError, "not implemented"):
                select_suites(["headline"], "linux-amd64", directory)
        for selection in (["all,unit"], ["build,unit"], ["unit,unit"], [""]):
            with self.assertRaises(ValueError):
                select_suites(selection, "linux-amd64", ROOT)
        for selection in ("smoke", "bm25", "stress", "recovery", "benchmark", "all"):
            with self.assertRaisesRegex(ValueError, "Linux verifier"):
                select_suites([selection], "macos-arm64", ROOT)
        with tempfile.TemporaryDirectory() as directory:
            tests = Path(directory) / "tests"
            tests.mkdir()
            for suite in SUITES:
                if suite != "unit":
                    (tests / (suite + ".py")).write_text("# Selection fixture only\n")
            self.assertEqual(select_suites(None, "linux-amd64", directory), list(SUITES))
            self.assertEqual(select_suites(None, "macos-arm64", directory), list(MAC_DEFAULT))
            self.assertEqual(ARCHIVE_SUITES, ("smoke", "symbol", "chain", "headline", "config", "recovery"))
            for suite in ("chain", "recovery"):
                (tests / (suite + ".py")).unlink()
                with self.assertRaisesRegex(ValueError, "not implemented"):
                    select_suites([suite], "linux-amd64", directory)

    def test_disclosed_symbol_costs_cannot_disappear_from_delivery(self):
        report=self.report()
        require_release_report(report)
        del report["symbol_quality_costs"]
        with self.assertRaisesRegex(ValueError,"symbol precision"):
            require_release_report(report)
        report=self.report()
        report["symbol_quality_costs"][0]["native_actual"]=False
        with self.assertRaisesRegex(ValueError,"symbol precision"):
            require_release_report(report)

    def test_exact_quality_failures_are_separate(self):
        frozen = frozen_quality_cases()
        cases = [quality_case(case_id, **dict(values,actual=True if case_id in REVIEWED_QUALITY_RESOLUTIONS else values["actual"]), known_signature=values) for case_id, values in frozen.items()]
        summary = validate_quality({"format": FORMAT, "cases": cases})
        self.assertEqual(summary["counts"], {"passed": 2, "known-failure": 1, "warning": 0, "regression": 0})
        self.assertEqual(verified_status(summary), "verified-with-known-quality-failures")
        values = frozen["english-den"]
        for field, changed in (("actual", False), ("input", "different document"), ("query", "different query"), ("config", "other.config"), ("expected", False), ("actual", 0)):
            case = quality_case("english-den", **dict(values, **{field: changed}), known_signature=values)
            self.assertEqual(case["status"], "regression", field)
            self.assertEqual(verified_status(validate_quality({"format": FORMAT, "cases": [case]})), "failed")
        case["status"] = "known-failure"
        with self.assertRaises(ValueError):
            validate_quality({"format": FORMAT, "cases": [case]})
        with self.assertRaisesRegex(ValueError, "not an eligible"):
            quality_case("new-unreviewed-failure", **values, known_signature=values)
        with self.assertRaisesRegex(ValueError, "reviewed frozen signature"):
            quality_case("english-den", **values)
        for changed in ({**values, "query": "new query"}, {**values, "actual": True}, {**values, "actual": 0}):
            with self.assertRaisesRegex(ValueError, "reviewed frozen signature"):
                quality_case("english-den", **changed, known_signature=changed)
        case = quality_case("english-den", **values, known_signature=values)
        del case["known_signature"]
        with self.assertRaises(ValueError):
            validate_quality({"format": FORMAT, "cases": [case]})
        self.assertEqual(quality_case("english-den",**values,known_signature=values)["status"],"regression")
        phrase=frozen["english-short-phrase"]
        self.assertEqual(quality_case("english-short-phrase",**phrase,known_signature=phrase)["status"],"known-failure")
        self.assertEqual(quality_case("english-short-phrase",**dict(phrase,actual=True),known_signature=phrase)["status"],"regression")
        self.assertEqual(quality_case("new-passing-case", **dict(values, actual=True))["status"], "passed")
        self.assertEqual(quality_case("new-failing-case", **values)["status"], "regression")
        with self.assertRaises(ValueError):
            from report_contract import require_known_quality_cases
            require_known_quality_cases(validate_quality({"format": FORMAT, "cases": []}))

    def test_reviewed_bm25_difference_is_a_warning(self):
        original = json.loads((ROOT / "tests/fixtures/quality-warnings-original.json").read_text())
        row = next(case for case in original["cases"] if case["id"] == "bm25-domain-surface_running")
        fields = {key: row[key] for key in ("input", "query", "config", "expected", "actual")}
        case = quality_case(row["id"], **fields)
        self.assertEqual(case["status"], "warning")

    def test_warning_scope_is_exact_and_never_quality_pass(self):
        original = json.loads((ROOT / QUALITY_WARNING_REVIEW["file"]).read_text())
        self.assertEqual(digest(ROOT / QUALITY_WARNING_REVIEW["file"]),
                         "ae335da2f89aae7eb10e59ab86aaf3f8233488cddafa06371b6ae9a2d8243b22")
        reviewed = [row for row in original["cases"] if row["status"] == "regression"]
        self.assertEqual({row["id"] for row in reviewed}, REVIEWED_QUALITY_WARNINGS)
        cases = []
        for row in reviewed:
            fields = {key: row[key] for key in QUALITY_FIELDS}
            case = quality_case(row["id"], **fields)
            self.assertEqual(case["status"], "warning", row["id"])
            cases.append(case)
            for field in QUALITY_FIELDS:
                changed = copy.deepcopy(fields)
                # Changing any one serialized field must revoke the warning.
                changed[field] = {"unreviewed": changed[field]}
                altered = quality_case(row["id"], **changed)
                self.assertEqual(altered["status"], "regression", (row["id"], field))
            for renamed in (row["id"] + "-new", "unreviewed-" + row["id"]):
                self.assertEqual(quality_case(renamed, **fields)["status"], "regression")
            if isinstance(fields["actual"], list):
                if fields["expected"]:
                    missing = dict(fields, actual=[value for value in fields["actual"] if value not in fields["expected"]])
                    self.assertEqual(quality_case(row["id"], **missing)["status"], "regression")
            else:
                # JSON booleans and numbers are not interchangeable signatures.
                self.assertEqual(quality_case(row["id"], **dict(fields, actual=int(fields["actual"])))["status"], "regression")
        summary = validate_quality({"format": FORMAT, "cases": cases})
        self.assertEqual(summary["counts"], {"passed": 0, "known-failure": 0, "warning": 47, "regression": 0})
        self.assertEqual(set(summary["warnings"]), REVIEWED_QUALITY_WARNINGS)
        self.assertEqual(verified_status(summary), "verified-with-quality-warnings")
        for forged_status in ("passed", "known-failure"):
            forged = copy.deepcopy(cases[0])
            forged["status"] = forged_status
            with self.assertRaises(ValueError):
                validate_quality({"format": FORMAT, "cases": [forged]})
        for key in ("counts", "warnings", "warning_review"):
            forged = copy.deepcopy(summary)
            forged[key] = {} if key != "warnings" else []
            with self.assertRaises(ValueError):
                validate_quality(forged)

    def test_release_warning_disclosure_preserves_all_other_gates(self):
        report = self.report()
        require_release_report(report)
        for key in ("counts", "warnings", "warning_review"):
            changed = copy.deepcopy(report)
            del changed["quality"][key]
            with self.assertRaisesRegex(ValueError, "disclosure"):
                require_release_report(changed)
        changed = copy.deepcopy(report)
        changed["quality"]["cases"] = [case for case in changed["quality"]["cases"] if case["id"] != "bm25-topk-domain"]
        changed["quality"] = validate_quality({"format": FORMAT, "cases": changed["quality"]["cases"]})
        with self.assertRaisesRegex(ValueError, "Missing reviewed"):
            require_release_report(changed)
        for key, value in (("suite_results", {}), ("cleanup", {}), ("recovery", {})):
            with self.assertRaises(ValueError):
                require_release_report(dict(report, **{key: value}))
        changed = copy.deepcopy(report)
        changed["commands"][0]["exit_code"] = 1
        with self.assertRaises(ValueError):
            require_release_report(changed)

    def test_warning_evidence_hash_cannot_be_replaced(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            for name in ("scripts/report_contract.py", "tests/fixtures/quality-known.json", QUALITY_WARNING_REVIEW["file"]):
                target = root / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(ROOT / name, target)
            evidence = root / QUALITY_WARNING_REVIEW["file"]
            evidence.write_bytes(evidence.read_bytes() + b"\n")
            command = "import sys; sys.path.insert(0, 'scripts'); from report_contract import quality_case; quality_case('unreviewed', input='', query='', config='public.charabia', expected=True, actual=True)"
            result = subprocess.run([sys.executable, "-c", command], cwd=root, text=True, capture_output=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn("Reviewed quality warning evidence changed", result.stderr)

    def report(self):
        labels = ("unit", "fmt", "clippy", "schema", "package", "fts-callback-abi", "public-api-abi", "default-objects", "analysis-info", "documentation-examples", "runner-contract", "word-generator-contract", "resource-verification", "normal-cargo-tree")
        report = {"format": FORMAT, "status": "verified-with-quality-warnings", "platform": "linux-amd64", "build_profile": "release", "test_hooks": False,
                "suites": list(SUITES), "suite_results": {suite: {"status": "passed"} for suite in SUITES},
                "cleanup": {key: True for key in ("marker_matches", "cluster_stopped", "directory_removed")},
                "quality": {"format": FORMAT, "cases": [quality_case(case_id, **dict(values,actual=True if case_id in REVIEWED_QUALITY_RESOLUTIONS else values["actual"]), known_signature=values) for case_id, values in frozen_quality_cases().items()] + [quality_case(case_id, **values) for case_id, values in reviewed_quality_warnings().items()]}, "analysis_info_verified": True, "fts_callback_abi_verified": True,
                "analysis_info": self.info(), "public_api_abi_verified": True, "default_objects_verified": True,
                "default_objects": self.default_objects(),
                "symbol_quality_costs":[{"input":"100 ms","query":"100ms","domain_expected":False,"native_actual":True}],
                "loaded_library_sha256": "f" * 64,
                "recovery": {"format": FORMAT, "status": "passed", "loaded_library_sha256": "f" * 64, "cleanup": {key: True for key in ("marker_matches", "clusters_stopped", "directory_removed")}},
                "pg_textsearch": {"loaded_backend_verified": True},
                "commands": [{"label": label, "exit_code": 0} for label in labels] + [{"label": f"suite-{suite}-python", "exit_code": 0} for suite in SUITES if suite != "unit"]}
        report["quality"] = validate_quality(report["quality"])
        return report

    def info(self):
        return {"extension": RELEASE_VERSION, "pgrx": "0.19.3", "charabia": "0.10.0", "target": "x86_64-unknown-linux-gnu", "cargo_lock_sha256": "a" * 64,
                "resource_manifest_sha256": "b" * 64, "analysis_revision": ANALYSIS_REVISION, "resource_fingerprint": "c" * 64,
                "language_count": 16, "languages": language_capabilities(), "symbols": symbol_identity(), "resources": {}}

    def default_objects(self):
        return default_catalog()

    def test_manifest_separates_build_sources_from_runtime_data(self):
        manifest=json.loads((ROOT/"resources/manifest.json").read_text())
        self.assertEqual({row["crate"] for row in manifest["embedded_data"]},{"charabia"})
        self.assertEqual({row["path"] for row in manifest["embedded_data"]}, {
            "dictionaries/fst/thai/words.fst", "dictionaries/fst/german/words.fst",
            "dictionaries/bin/nonspacing_mark/marks.bin"})
        nltk={row["path"].split("/")[-1] for row in manifest["build_source_files"] if row["path"].startswith("src/nltk/")}
        self.assertEqual(nltk,{"arabic","chinese","dutch","english","french","german","italian","portuguese","russian","spanish","turkish"})
        self.assertEqual(set(manifest["compiled_stop_sets"]),set(LANGUAGE_CODES)-{"und"})

    def test_static_info_rejects_old_configuration_state(self):
        info = self.info()
        require_static_info(info, {"extension": RELEASE_VERSION, "target": "x86_64-unknown-linux-gnu"})
        for changed in (dict(info, extension="0.2.0"), dict(info, settings={}), dict(info, test_hooks=False), dict(info, language_count=71), dict(info, language_count=16.0), dict(info, analysis_revision="native-dictionary-0.3.0"), dict(info, resource_fingerprint="invalid")):
            with self.assertRaises(ValueError):
                require_static_info(changed, {})
        duplicate = copy.deepcopy(info)
        duplicate["languages"][0]["language"] = duplicate["languages"][1]["language"]
        with self.assertRaisesRegex(ValueError, "unique"):
            require_static_info(duplicate, {})
        wrong_default = copy.deepcopy(info)
        wrong_default["languages"][0]["defaults"]["filter"] = True
        with self.assertRaisesRegex(ValueError, "defaults"):
            require_static_info(wrong_default, {})
        for field, value in (("language", "dan"), ("script", "Other"), ("stemmer", "French"), ("english_eligible", True), ("english_eligible", 0)):
            changed = copy.deepcopy(info)
            changed["languages"][0][field] = value
            with self.assertRaises(ValueError, msg=field):
                require_static_info(changed, {})
        swapped = copy.deepcopy(info)
        swapped["languages"][:2] = swapped["languages"][:2][::-1]
        with self.assertRaisesRegex(ValueError, "order"):
            require_static_info(swapped, {})
        rows = info["languages"]
        self.assertEqual(sum(row["has_stopwords"] for row in rows), 15)
        self.assertEqual(sum(row["stemmer"] is not None for row in rows), 10)
        self.assertEqual(sum(row["defaults"]["discard"] for row in rows), 15)
        self.assertEqual(sum(row["defaults"]["stem"] for row in rows), 11)
        self.assertEqual(sum(row["defaults"]["english"] for row in rows), 8)

    def test_installed_default_catalog_requires_routes_and_explicit_options(self):
        defaults = self.default_objects()
        require_default_objects(defaults, self.info())
        quoted=copy.deepcopy(defaults)
        for row in quoted["dictionary_options"]:
            row["options"]=row["options"].replace("normalize =", '"normalize" =')
        require_default_objects(quoted,self.info())
        # PG quotes its NORMALIZE keyword in dictinitoption output.
        for field in defaults:
            missing = copy.deepcopy(defaults)
            del missing[field]
            with self.assertRaises(ValueError, msg=field):
                require_default_objects(missing, self.info())
        for field in ("types", "dictionaries", "dictionary_options", "mappings"):
            changed = copy.deepcopy(defaults)
            changed[field].pop()
            with self.assertRaises(ValueError, msg=field):
                require_default_objects(changed, self.info())
        changed = copy.deepcopy(defaults)
        changed["parser"]["schema"] = "public"
        with self.assertRaisesRegex(ValueError, "Configuration"):
            require_default_objects(changed, self.info())
        changed = copy.deepcopy(defaults)
        changed["mappings"][0]["dictionary_schema"] = "public"
        with self.assertRaisesRegex(ValueError, "mappings"):
            require_default_objects(changed, self.info())
        changed = copy.deepcopy(defaults)
        changed["types"][:2] = changed["types"][:2][::-1]
        with self.assertRaisesRegex(ValueError, "Parser types"):
            require_default_objects(changed, self.info())
        for changed_option in ("language = 'ara'", defaults["dictionary_options"][0]["options"].replace("english = 'false'", "english = 'true'"),
                               defaults["dictionary_options"][0]["options"] + ", english = 'false'",
                               defaults["dictionary_options"][0]["options"].replace("english = 'false'", "english = false")):
            changed = copy.deepcopy(defaults)
            changed["dictionary_options"][0]["options"] = changed_option
            with self.assertRaises(ValueError, msg=changed_option):
                require_default_objects(changed, self.info())
        for field, value in (("template_schema", "public"), ("template", "simple"), ("dictionary", "und")):
            changed = copy.deepcopy(defaults)
            changed["dictionary_options"][0][field] = value
            with self.assertRaisesRegex(ValueError, "template"):
                require_default_objects(changed, self.info())

    def test_recovery_cleanup_and_loaded_library_are_required(self):
        recovery = self.report()["recovery"]
        require_recovery_report(recovery, "f" * 64)
        for changed in (dict(recovery, status="failed"), dict(recovery, cleanup={}), dict(recovery, loaded_library_sha256="e" * 64), dict(recovery, format=1)):
            with self.assertRaises(ValueError):
                require_recovery_report(changed, "f" * 64)
        for key in ("marker_matches", "clusters_stopped", "directory_removed"):
            with self.assertRaisesRegex(ValueError, "cleanup"):
                require_recovery_report(dict(recovery, cleanup=dict(recovery["cleanup"], **{key: False})), "f" * 64)
        with self.assertRaises(ValueError):
            require_recovery_report(dict(recovery, loaded_library_sha256=None), None)

    def test_release_refuses_incomplete_identity_or_checks(self):
        report = self.report()
        require_release_report(report)
        for key, value in (("format", 1), ("status", "passed"), ("build_profile", "debug"), ("test_hooks", True), ("suites", list(SUITES[:-1])), ("suite_results", {}), ("commands", []), ("analysis_info_verified", False), ("public_api_abi_verified", False), ("default_objects_verified", False), ("default_objects", {}), ("recovery", {}), ("cleanup", {})):
            invalid = dict(report, **{key: value})
            with self.assertRaises(ValueError, msg=key):
                require_release_report(invalid)
        failed = copy.deepcopy(report)
        failed["commands"][0]["exit_code"] = 1
        with self.assertRaises(ValueError):
            require_release_report(failed)

    def test_release_identity_refusals(self):
        report = {"git_status": "", "git_commit": "a" * 40, "library": {"sha256": "b" * 64}, "loaded_library_sha256": "b" * 64, "cargo_lock_sha256": "c" * 64, "resources_sha256": "d" * 64}
        identity = dict(commit="a" * 40, status="", lock_hash="c" * 64, resources_hash="d" * 64, library_hash="b" * 64)
        require_release_identity(report, **identity)
        for key, value in (("commit", "other"), ("status", " M src/lib.rs"), ("lock_hash", "other"), ("resources_hash", "other"), ("library_hash", "other")):
            with self.assertRaises(ValueError, msg=key):
                require_release_identity(report, **dict(identity, **{key: value}))
        with self.assertRaises(ValueError):
            require_release_identity(dict(report, git_status=" M src/lib.rs"), **identity)

    def test_archive_rejects_links_and_escaping_paths(self):
        specification = importlib.util.spec_from_file_location("delivery_check", ROOT / "scripts/check-delivery.py")
        module = importlib.util.module_from_spec(specification)
        specification.loader.exec_module(module)
        for name, kind in (("root/../escape", tarfile.REGTYPE), ("/escape", tarfile.REGTYPE), ("root/link", tarfile.SYMTYPE), ("root/./file", tarfile.REGTYPE)):
            with tempfile.TemporaryDirectory() as directory:
                archive = Path(directory) / "delivery.tar.gz"
                with tarfile.open(archive, "w:gz") as output:
                    info = tarfile.TarInfo(name)
                    info.type = kind
                    info.linkname = "/outside"
                    output.addfile(info, io.BytesIO(b""))
                with self.assertRaises(ValueError, msg=name):
                    module.unpack_archive(archive, Path(directory) / "unpacked")

    def test_package_rejects_all_symbolic_links(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory).resolve()
            package = root / "package"
            package.mkdir()
            data = package / "extension.so"
            data.write_bytes(b"verified")
            (package / "SHA256SUMS").write_text(f"{digest(data)}  extension.so\n")
            verify_checksums(package)
            outside = root / "outside"
            outside.mkdir()
            (outside / "unverified-secret").write_text("must not be copied")
            for name, target in (("leaf", data), ("outside-dir", outside), ("inside-dir", package), ("dangling", root / "absent")):
                link = package / name
                link.symlink_to(target, target_is_directory=target.is_dir())
                with self.assertRaisesRegex(ValueError, "symbolic link", msg=name):
                    verify_checksums(package)
                link.unlink()
            root_link = root / "package-link"
            root_link.symlink_to(package, target_is_directory=True)
            with self.assertRaisesRegex(ValueError, "symbolic link"):
                verify_checksums(root_link)
            ancestor = root / "ancestor-link"
            ancestor.symlink_to(root, target_is_directory=True)
            with self.assertRaisesRegex(ValueError, "symbolic link"):
                verify_checksums(ancestor / "package")

    def test_package_source_copy_excludes_ignored_descendants(self):
        # A synthetic report and library test assembly only. They are never
        # accepted as PostgreSQL or release verification evidence.
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            names = ("scripts/package-release", "scripts/report_contract.py", "LICENSE", "README.md",
                     "Cargo.toml", "Cargo.lock", "build.rs", "AGENTS.md", ".gitattributes", "rust-toolchain.toml", "pg_charabia.control", "src/lib.rs", "sql/pg_charabia.sql", "docker/verify.Dockerfile", "scripts/generate-english.py", "scripts/rebuild-german", "resources/english/words.txt", "resources/english/attribution/headword-pages.txt.gz",
                     "resources/manifest.json", "docker/environment.lock.json", "tests/fixtures/quality-known.json", "tests/fixtures/quality-warnings-original.json")
            for name in names:
                target = root / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(ROOT / name, target)
            # Freeze the synthetic archive identities before committing this fixture.
            fixture_path=root/"resources/manifest.json"
            fixture_manifest=json.loads(fixture_path.read_text())
            payload=b"Synthetic source-copy archive fixture. Never compile this.\n"
            for source in fixture_manifest["rebuild_source_archives"]:
                source["sha256"]=hashlib.sha256(payload).hexdigest()
            fixture_path.write_text(json.dumps(fixture_manifest))
            nested = root / "docs/nested/source.md"
            nested.parent.mkdir(parents=True)
            nested.write_bytes(b"Tracked nested documentation.\n")
            (root / ".gitignore").write_text("docs/research/\n**/.DS_Store\n**/__pycache__/\nscripts/local-only/\nevidence/\ndist/\n")
            def git(*args):
                return subprocess.check_output(["git", "-c", "user.name=Package contract test",
                    "-c", "user.email=package-test@example.invalid", "-c", "core.hooksPath=/dev/null",
                    "-c", "commit.gpgsign=false", *args], cwd=root, stderr=subprocess.PIPE, text=True).strip()
            git("init", "--quiet")
            git("add", ".")
            git("commit", "--quiet", "-m", "Freeze package-copy fixture")
            commit = git("rev-parse", "HEAD")
            for name in ("docs/research/.DS_Store", "docs/.DS_Store", "scripts/local-only/data"):
                target = root / name
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(b"Ignored local material must stay outside delivery.\n")
            evidence = root / "evidence"
            inner = evidence / "fixture-inner"
            package = inner / "package"
            (package / "extension").mkdir(parents=True)
            library = package / "extension/pg_charabia.so"
            library.write_bytes(b"Synthetic assembly fixture. Never load this file.\n")
            library_hash = digest(library)
            # These are source-copy assembly fixtures, never runtime/release evidence.
            resource_path=root/"resources/manifest.json"
            fixture_resources=json.loads(resource_path.read_text())
            for source in fixture_resources["rebuild_source_archives"]:
                path=package/source["package_path"]
                path.parent.mkdir(parents=True,exist_ok=True)
                path.write_bytes(b"Synthetic source-copy archive fixture. Never compile this.\n")
                self.assertEqual(source["sha256"],digest(path))
            (package/"SHA256SUMS").write_text("".join(f"{digest(path)}  {path.relative_to(package)}\n" for path in sorted(package.rglob("*")) if path.is_file() and path.name!="SHA256SUMS"))
            report = self.report()
            report["quality"] = validate_quality(report["quality"])
            report.update(run_id="fixture-inner", git_commit=commit, git_status="",
                          postgres="PostgreSQL 18.6", target_triple="x86_64-unknown-linux-gnu",
                          library={"sha256": library_hash}, loaded_library_sha256=library_hash,
                          cargo_lock_sha256=digest(root / "Cargo.lock"), resources_sha256=digest(root / "resources/manifest.json"))
            report["recovery"]["loaded_library_sha256"] = library_hash
            (inner / "run.json").write_text(json.dumps(report))
            (evidence / "outer-run.json").write_text(json.dumps({"format": FORMAT, "run_id": "fixture",
                "status": report["status"], "platform": "linux/amd64", "image_id": "assembly-only",
                "cleanup": {"container_removed": True, "volumes_removed": True}}))
            self.assertEqual(git("status", "--porcelain=v1"), "")
            result = subprocess.run([sys.executable, str(root / "scripts/package-release"),
                "--run", str(evidence)], cwd=root, text=True, capture_output=True)
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
            archive = Path(json.loads(result.stdout)["archive"])
            with tarfile.open(archive, "r:gz") as source:
                prefix = archive.name.removesuffix(".tar.gz") + "/"
                members = {item.name.removeprefix(prefix) for item in source.getmembers()}
                self.assertEqual(source.extractfile(prefix + "docs/nested/source.md").read(), nested.read_bytes())
                for name in ("docs/research", "docs/research/.DS_Store", "docs/.DS_Store", "scripts/local-only/data"):
                    self.assertNotIn(name, members)
            for name in ("docs/research/.DS_Store", "docs/.DS_Store", "scripts/local-only/data"):
                self.assertEqual((root / name).read_bytes(), b"Ignored local material must stay outside delivery.\n")

    def test_checksums_cover_every_file_and_forbid_escape(self):
        with tempfile.TemporaryDirectory() as directory:
            package = Path(directory).resolve()
            data = package / "extension.so"
            data.write_bytes(b"owned test data")
            manifest = package / "SHA256SUMS"
            manifest.write_text(f"{digest(data)}  extension.so\n")
            verify_checksums(package)
            (package / "unlisted").write_text("unexpected")
            with self.assertRaisesRegex(ValueError, "incomplete"):
                verify_checksums(package)
            (package / "unlisted").unlink()
            data.write_bytes(b"changed")
            with self.assertRaisesRegex(ValueError, "mismatch"):
                verify_checksums(package)
            manifest.write_text(f"{'0' * 64}  ../outside\n")
            with self.assertRaisesRegex(ValueError, "Invalid package"):
                verify_checksums(package)


if __name__ == "__main__":
    unittest.main()
