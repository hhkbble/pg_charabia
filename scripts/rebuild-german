#!/usr/bin/env python3
"""Rebuild Charabia's pinned German FST from its complete UTF-8 source."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import tempfile

PINNED_SOURCE = "9a643bc1e0ce04337100a4b62a39d3e8ead004458d46f5ddf01c0c02ec5844a1"
PINNED_FST = "fafef0c1258549ed3a7fac0d73bbcc874226e58d43d61eb20bddf30256ed96e2"
RUST_SOURCE = r'''
use std::{collections::BTreeSet, env, fs};
fn main() {
    let args: Vec<_> = env::args().collect();
    let text = fs::read_to_string(&args[1]).expect("read UTF-8 word source");
    // The upstream resource includes header/comment and empty lines as keys.
    let keys: BTreeSet<_> = text.lines().collect();
    let bytes = fst::Set::from_iter(keys).expect("sorted unique keys")
        .into_fst().into_inner();
    fs::write(&args[2], bytes).expect("write rebuilt FST");
}
'''


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parent.parent / "resources/notices/german-words-source.txt")
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--allow-modified-source", action="store_true", help="rebuild edited data without claiming the pinned output identity")
    args = parser.parse_args()
    source = args.source.resolve()
    output = args.output.resolve()
    if source == output or (output.exists() and source.samefile(output)):
        parser.error("output must differ from the source")
    source_sha = sha(source)
    if not args.allow_modified_source and source_sha != PINNED_SOURCE:
        parser.error("source SHA-256 differs; inspect it or use --allow-modified-source for an intentional edit")
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="pg-charabia-german-rebuild-") as owned:
        project = Path(owned)
        (project / "src").mkdir()
        (project / "Cargo.toml").write_text('[package]\nname = "pg-charabia-german-rebuild"\nversion = "0.0.0"\nedition = "2024"\n[dependencies]\nfst = "=0.4.7"\n', encoding="utf-8")
        (project / "src/main.rs").write_text(RUST_SOURCE, encoding="utf-8")
        subprocess.run(["cargo", "generate-lockfile", "--offline", "--manifest-path", str(project / "Cargo.toml")], check=True)
        subprocess.run(["cargo", "run", "--offline", "--locked", "--release", "--manifest-path", str(project / "Cargo.toml"), "--", str(source), str(output)], check=True)
    actual = sha(output)
    if not args.allow_modified_source and actual != PINNED_FST:
        raise SystemExit("rebuilt FST differs from the pinned hash; output retained for diagnosis")
    print(json.dumps({"source_sha256": source_sha, "fst_sha256": actual,
                      "fst_bytes": output.stat().st_size,
                      "pinned_identity": source_sha == PINNED_SOURCE and actual == PINNED_FST,
                      "fst_version": "0.4.7", "rule": "all UTF-8 str.lines(), including headers and empty lines; byte-sort unique"}, indent=2))


if __name__ == "__main__":
    main()
